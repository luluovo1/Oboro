; RUN: opt -S -passes='default<O2>' -irobf-vmp < %s -o - | FileCheck %s
;
; The interpreter's register file has 235 usable slots.  A function with more
; cross-block values than that is translated a second time with those values
; kept in the wrapper frame instead of the register file, so it is still
; virtualized rather than skipped.
;
; `optnone` keeps the 240 phis exactly as written: a later optimization would
; merge the loop-carried values and the function would fit again.
;
; The alloca is read and written in the entry block only, so its pointer stays
; in a register even though every other cross-block value lives in the frame.
;
; CHECK: define i64 @spill_many_phis(i64 %n)
; CHECK-NOT: phi i64
; CHECK: call i64 @
; CHECK: ret i64
; CHECK: define internal i64 @
; CHECK: switch i32

define i64 @spill_many_phis(i64 %n) optnone noinline {
entry:
  %slot = alloca i64, align 8
  store i64 5, ptr %slot, align 8
  %base = load i64, ptr %slot, align 8
  br label %loop
loop:
